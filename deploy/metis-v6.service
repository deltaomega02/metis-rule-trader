[Unit]
Description=METIS v6 breakout portfolio engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_SERVICE_USER
WorkingDirectory=/opt/metis-rule-trader
EnvironmentFile=/opt/metis-rule-trader/.env
ExecStart=/opt/metis-rule-trader/venv/bin/python3 -u main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
